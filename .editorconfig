root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[{*.go,go.mod,go.sum}]
indent_style = tab

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.vibe]
indent_style = space
indent_size = 2

[{testdata/**,**/testdata/**}]
insert_final_newline = unset
trim_trailing_whitespace = unset
