app Shop {}

auth User

model User {
  name: Text min 2
  email: Email unique
}

model Book {
  title: Text min 2 max 200
  seller: Ref User
  pages: Int min 1
  price: Money min 0
  published: Bool = false
}

feature Books {
  get /cheap = Book.where(price * 2 < 10)

  get /search (q: Text) = Book.where(q contains title)
}
