app Shop {}

auth User

model User {
  name: Text min 2
  email: Email unique
}

model Book {
  title: Text min 2 max 200
  seller: Ref User
  pages: Int min 1
  price: Money min 0
  published: Bool = false
}

feature Books {
  post /books/{id}/publish {
    let book = Book.find(id)
    if book.published { fail 409 "already published" }
    return book.update(published: true)
  }
}
