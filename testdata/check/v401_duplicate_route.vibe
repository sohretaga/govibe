app Shop {}

auth User

model User {
  name: Text min 2
  email: Email unique
}

model Book {
  title: Text min 2 max 200
  seller: Ref User
  pages: Int min 1
  price: Money min 0
  published: Bool = false
}

feature Books {
  crud Book at /books

  get /books/{slug} = Book.all()

  get /healthz = "ok"
}
