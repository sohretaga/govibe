// handlePostPostsSlugView answers POST /posts/{slug}/view, declared at main.vibe:31:3.
func handlePostPostsSlugView(c *vibe.Ctx) error {
	slug := c.PathText("slug")
	in, err := c.Body()
	if err != nil {
		return err
	}
	if err := in.Err(); err != nil {
		return err
	}
	t1, err := findPostBySlug(c, slug)
