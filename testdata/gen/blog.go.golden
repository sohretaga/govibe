// handleGetWords answers GET /words, declared at main.vibe:59:3.
func handleGetWords(c *vibe.Ctx) error {
	in := c.Query()
	text := vibe.Req[string](in, "text", vibe.AsText)
	if err := in.Err(); err != nil {
		return err
	}
	return c.OK([]string{vibe.Str(vibe.Len(text)) + " chars", vibe.Str(fnScore(int64(3), float64(1.5))), strings.TrimSpace(strings.ToLower(text)), vibe.Str(vibe.Now().After(vibe.Now()))})
}
