func checkPost(c *vibe.Ctx, r *Post, errs *vibe.Errors) error {
	if n := vibe.Len(r.Title); n < 3 {
		errs.Invalid("title", "must be at least 3 characters")
	} else if n > 200 {
		errs.Invalid("title", "must be at most 200 characters")
	}
	if r.Slug != "" && !vibe.ValidSlug(r.Slug) {
		errs.Invalid("slug", "must be lowercase letters, digits and dashes, like salam-dunya")
	}
	return nil
}

