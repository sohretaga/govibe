// it.
func insertPost(c *vibe.Ctx, r *Post, errs *vibe.Errors) (*Post, error) {
	now := vibe.Now()
	r.ID, r.CreatedAt, r.UpdatedAt = c.NewID(), now, now
	if err := checkPost(c, r, errs); err != nil {
		return nil, err
	}
	if err := errs.Err(); err != nil {
		return nil, err
	}
	if r.Slug == "" {
		s, err := vibe.UniqueSlug(r.Title, "post", func(s string) (bool, error) { return c.Exists(sqlPostSlugTaken, s) })
		if err != nil {
			return nil, err
		}
		r.Slug = s
	}
	if err := c.Exec(sqlPostInsert, argsPost(r)...); err != nil {
		return nil, err
	}
	return r, nil
}

// updatePost checks a changed Post, adding its problems to errs, and
// stores it.
func updatePost(c *vibe.Ctx, r *Post, errs *vibe.Errors) (*Post, error) {
	r.UpdatedAt = vibe.Now()
	if err := checkPost(c, r, errs); err != nil {
		return nil, err
	}
	if err := errs.Err(); err != nil {
		return nil, err
	}
	if err := c.Exec(sqlPostUpdate, argsPost(r)...); err != nil {
		return nil, err
	}
	return r, nil
}

// deletePost removes a Post.
