		t2, err := runQuery2(c, it.Views)
		if err != nil {
			return err
		}
		t3 = t2 == int64(0)
	}
	if t3 {
		return vibe.Fail(vibe.Conflict, "the most viewed post is read-only")
	}
	rating := it.Rating
	if rating != nil {
		if (*rating) > float64(4.5) {
			t4 := *it
			t4.Views = it.Views + int64(1)
			t4.Rating = vibe.Ptr(*rating)
			var t5 vibe.Errors
			t6, err := updatePost(c, &t4, &t5)
			if err != nil {
				return err
			}
			return c.OK(t6)
		}
	} else {
		t7, err := runQuery3(c)
		if err != nil {
			return err
		}
		if t7 > int64(10) {
			t8 := *it
			t8.Views = it.Views + int64(2)
			var t9 vibe.Errors
			t10, err := updatePost(c, &t8, &t9)
			if err != nil {
				return err
			}
			return c.OK(t10)
		}
	}
	t11 := *it
	t11.Views = it.Views + int64(1)
	var t12 vibe.Errors
	t13, err := updatePost(c, &t11, &t12)
	if err != nil {
		return err
	}
	return c.OK(t13)
}

