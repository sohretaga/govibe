package main

import (
	"database/sql/driver"
	"os"

	"modernc.org/sqlite"
	vibe "vibeapp/runtime"
)

// main starts Blog. Flags override environment variables, which
// override the app block: --port or VIBE_PORT, --db or VIBE_DB.
func main() {
	sqlite.MustRegisterDeterministicScalarFunction("vibe_contains", 2, func(_ *sqlite.FunctionContext, args []driver.Value) (driver.Value, error) {
		return vibe.SQLContains(args)
	})
	app := &vibe.App{
		Name:    "Blog",
		DB:      "sqlite://blog.db",
		Tables:  tables(),
		Queries: queries(),
		Routes:  routes(),
	}
	os.Exit(app.Main(os.Args[1:]))
}
