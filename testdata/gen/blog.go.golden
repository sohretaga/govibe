package main

import (
	vibe "vibeapp/runtime"
)

// fnExcerpt is fn excerpt, declared at main.vibe:13:1.
func fnExcerpt(text string, n int64) string {
	if vibe.Len(text) <= n {
		return text
	}
	return text + "..."
}

// fnScore is fn score, declared at main.vibe:20:1.
func fnScore(views int64, rating float64) float64 {
	return (float64(views) * rating) / float64(2)
}
