	r.Sold = vibe.Def(in, "sold", vibe.AsBool, false)
	r.SoldAt = vibe.Opt[time.Time](in, "sold_at", vibe.AsTime)
	r.Code = vibe.Opt[string](in, "code", vibe.AsText)
	r.Parent = vibe.Opt[string](in, "parent", vibe.AsID)
