// loadMe returns the User of the request's session, or answers
// login_required. It renews a session at most once a day.
func loadMe(c *vibe.Ctx) (*model.User, error) {
	token := c.SessionToken()
	if token == "" {
		return nil, vibe.NeedLogin()
	}
	hash := vibe.HashToken(token)
	var expires time.Time
	me, err := scanUser(vibe.WithExtra(c.Row(sqlSessionUser, hash, vibe.TimeArg(vibe.Now())), vibe.ScanTime(&expires)))
	if errors.Is(err, vibe.ErrNoRow) {
		return nil, vibe.NeedLogin()
	}
	if err != nil {
		return nil, err
	}
	if vibe.NeedsRenewal(expires) {
		if err := c.Exec(sqlSessionRenew, hash, vibe.TimeArg(vibe.SessionExpiry())); err != nil {
			return nil, err
		}
		if c.HasSessionCookie() {
			c.SetSessionCookie(token)
		}
	}
	return me, nil
}

// startSession starts a session for u, sets its cookie and returns its
// token. It first removes the sessions that expired.
func startSession(c *vibe.Ctx, u *model.User) (string, error) {
	if err := c.Exec(sqlSessionPurge, vibe.TimeArg(vibe.Now())); err != nil {
		return "", err
	}
	token, hash := vibe.NewToken()
	if err := c.Exec(sqlSessionInsert, hash, u.ID, vibe.TimeArg(vibe.SessionExpiry())); err != nil {
		return "", err
	}
	c.SetSessionCookie(token)
	return token, nil
}

// handleAuthRegister answers POST /auth/register, auth User register, declared at main.vibe:3:1.
func handleAuthRegister(c *vibe.Ctx) error {
	in, err := c.Body()
	if err != nil {
		return err
	}
	in.ReadOnly("id", "created_at", "updated_at")
	r := &model.User{}
	password := vibe.Req[string](in, "password", vibe.AsText)
	r.Email = vibe.Req[string](in, "email", vibe.AsEmail)
	r.Name = vibe.Req[string](in, "name", vibe.AsText)
	vibe.CheckPassword(&in.Errors, password)
	in.Done()
	if in.Errors.Err() == nil {
		// Hashing is slow, so it waits until the input is known to be good.
		hash, err := bcrypt.GenerateFromPassword([]byte(password), bcrypt.DefaultCost)
		if err != nil {
			return err
		}
		r.PasswordHash = vibe.Ptr(string(hash))
	}
	r, err = insertUser(c, r, &in.Errors)
	if err != nil {
		return err
	}
	token, err := startSession(c, r)
	if err != nil {
		return err
	}
	return c.Created(vibe.Session{User: r, Token: token})
}

// handleAuthLogin answers POST /auth/login, auth User login, declared at main.vibe:3:1.
func handleAuthLogin(c *vibe.Ctx) error {
	if err := c.LoginAttempt(); err != nil {
		return err
	}
	in, err := c.Body()
	if err != nil {
		return err
	}
	email := vibe.Req[string](in, "email", vibe.AsText)
	password := vibe.Req[string](in, "password", vibe.AsText)
	if err := in.Err(); err != nil {
		return err
	}
	u, err := vibe.First(c, sqlUserByEmail, scanUser, email)
	if err != nil {
		return err
	}
	hash := vibe.NoAccountHash
	if u != nil && u.PasswordHash != nil {
		hash = *u.PasswordHash
	}
	// The hash is checked even without an account, so the answer takes as
	// long and reveals nothing about which emails have accounts.
	if bcrypt.CompareHashAndPassword([]byte(hash), []byte(password)) != nil || u == nil || u.PasswordHash == nil {
		return vibe.Fail(vibe.LoginRequired, "wrong email or password")
	}
	token, err := startSession(c, u)
	if err != nil {
		return err
	}
	return c.OK(vibe.Session{User: u, Token: token})
}

// handleAuthLogout answers POST /auth/logout, auth User logout, declared at main.vibe:3:1.
func handleAuthLogout(c *vibe.Ctx) error {
	in, err := c.Body()
	if err != nil {
		return err
