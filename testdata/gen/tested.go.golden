// runVibeTest runs one test on a fresh app and prints its failure for
// vibe test.
func runVibeTest(t *testing.T, test func(*vibe.Tester, *vibe.Ctx) error) {
	if err := newApp().Test(t.Context(), test); err != nil {
		t.Fatal(vibe.Report(err))
	}
}

