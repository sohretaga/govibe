// Code generated by vibe build from .vibe files. DO NOT EDIT.

package main

import (
	"vibeapp/model"
	vibe "vibeapp/runtime"
)

// routes returns every route of the app, crud routes included.
func routes() []vibe.Route {
	return []vibe.Route{
		{Method: "POST", Path: "/auth/register", Handle: handleAuthRegister},
		{Method: "POST", Path: "/auth/login", Handle: handleAuthLogin},
		{Method: "POST", Path: "/auth/logout", Handle: handleAuthLogout},
		{Method: "GET", Path: "/auth/me", Handle: handleAuthMe},
		{Method: "GET", Path: "/books", Handle: handleGetBooks},
		{Method: "GET", Path: "/books/{id}", Handle: handleGetBooksID},
		{Method: "POST", Path: "/books", Handle: handlePostBooks},
		{Method: "PATCH", Path: "/books/{id}", Handle: handlePatchBooksID},
		{Method: "DELETE", Path: "/books/{id}", Handle: handleDeleteBooksID},
		{Method: "GET", Path: "/books/search", Handle: handleGetBooksSearch},
		{Method: "GET", Path: "/healthz", Handle: vibe.Healthz},
	}
}

// handleGetBooks answers GET /books, crud Book list, declared at main.vibe:23:3.
func handleGetBooks(c *vibe.Ctx) error {
	in := c.Query()
	limit := vibe.Def(in, "limit", vibe.AsInt, int64(50))
	offset := vibe.Def(in, "offset", vibe.AsInt, int64(0))
	if limit < 0 || limit > 1000 {
		in.Invalid("limit", "must be between 0 and 1000")
	}
	if offset < 0 {
		in.Invalid("offset", "must be at least 0")
	}
	if err := in.Err(); err != nil {
		return err
	}
	out, err := vibe.All(c, sqlBookList, scanBook, limit, offset)
	if err != nil {
		return err
	}
	return c.OK(out)
}

// handleGetBooksID answers GET /books/{id}, crud Book get, declared at main.vibe:23:3.
func handleGetBooksID(c *vibe.Ctx) error {
	r, err := findBookByID(c, c.PathText("id"))
	if err != nil {
		return err
	}
	return c.OK(r)
}

// handlePostBooks answers POST /books, crud Book create, declared at main.vibe:23:3.
func handlePostBooks(c *vibe.Ctx) error {
	me, err := loadMe(c)
	if err != nil {
		return err
	}
	in, err := c.Body()
	if err != nil {
		return err
	}
	in.ReadOnly("id", "created_at", "updated_at", "seller")
	r := &model.Book{}
	r.Seller = me.ID
	r.Title = vibe.Req[string](in, "title", vibe.AsText)
	r.Slug = vibe.Deref(vibe.Opt[string](in, "slug", vibe.AsSlug))
	r.Pages = vibe.Req[int64](in, "pages", vibe.AsInt)
	r.Price = vibe.Req[vibe.Money](in, "price", vibe.AsMoney)
	r.Note = vibe.Opt[string](in, "note", vibe.AsText)
	r.Published = vibe.Def(in, "published", vibe.AsBool, false)
	in.Done()
	r, err = insertBook(c, r, &in.Errors)
	if err != nil {
		return err
	}
	return c.Created(r)
}

// handlePatchBooksID answers PATCH /books/{id}, crud Book update, declared at main.vibe:23:3.
func handlePatchBooksID(c *vibe.Ctx) error {
	me, err := loadMe(c)
	if err != nil {
		return err
	}
	r, err := findBookByID(c, c.PathText("id"))
	if err != nil {
		return err
	}
	if r.Seller != me.ID {
		return vibe.Fail(vibe.Forbidden, "only the seller of this Book can change it")
	}
	in, err := c.Body()
	if err != nil {
		return err
	}
