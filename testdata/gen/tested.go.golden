// handleDeleteBooksID answers DELETE /books/{id}, crud Book delete, declared at main.vibe:23:3.
func handleDeleteBooksID(c *vibe.Ctx) error {
	me, err := loadMe(c)
	if err != nil {
		return err
	}
	r, err := findBookByID(c, c.PathText("id"))
	if err != nil {
		return err
	}
	if r.Seller != me.ID {
		return vibe.Fail(vibe.Forbidden, "only the seller of this Book can change it")
	}
	if err := deleteBook(c, r); err != nil {
		return err
	}
	return c.Empty()
}

