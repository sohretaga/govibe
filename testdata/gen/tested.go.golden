package main

import (
	"database/sql/driver"
	"os"

	"modernc.org/sqlite"
	vibe "vibeapp/runtime"
)

// init registers vibe_contains, the SQL function of contains.
func init() {
	sqlite.MustRegisterDeterministicScalarFunction("vibe_contains", 2, func(_ *sqlite.FunctionContext, args []driver.Value) (driver.Value, error) {
		return vibe.SQLContains(args)
	})
}

// newApp returns Shelf: its tables, queries and routes.
func newApp() *vibe.App {
	return &vibe.App{
		Name:    "Shelf",
		DB:      "sqlite://shelf.db",
		Tables:  tables(),
		Queries: queries(),
		Routes:  routes(),
	}
}

// main starts Shelf. Flags override environment variables, which
// override the app block: --port or VIBE_PORT, --db or VIBE_DB.
func main() {
	os.Exit(newApp().Main(os.Args[1:]))
}
